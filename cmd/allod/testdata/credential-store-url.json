{
  "line": "^https://[^:[:space:]][^:[:space:]]*:[{]secret[}]@[^/[:space:]][^/[:space:]]*$",
  "blank_line": "^[ \t]*$",
  "vectors": [
    {
      "name": "canonical template",
      "accept": true,
      "credential": {
        "value": {
          "template": "https://template-user:{secret}@template.example"
        }
      }
    },
    {
      "name": "canonical template with trailing newline",
      "accept": true,
      "credential": {
        "value": {
          "template": "https://template-user:{secret}@template.example\n"
        }
      }
    },
    {
      "name": "blank-line padding",
      "accept": true,
      "credential": {
        "value": {
          "template": "\nhttps://template-user:{secret}@template.example\n\n"
        }
      }
    },
    {
      "name": "space-and-tab padding",
      "accept": true,
      "credential": {
        "value": {
          "template": "https://template-user:{secret}@template.example\n   \n\t\n"
        }
      }
    },
    {
      "name": "placeholder in user",
      "accept": false,
      "credential": {
        "value": {
          "template": "https://{secret}:password@template.example"
        }
      }
    },
    {
      "name": "missing placeholder",
      "accept": false,
      "credential": {
        "value": {
          "template": "https://template-user:password@template.example"
        }
      }
    },
    {
      "name": "two placeholders",
      "accept": false,
      "credential": {
        "value": {
          "template": "https://template-user:{secret}@{secret}.example"
        }
      }
    },
    {
      "name": "colon in user",
      "accept": false,
      "credential": {
        "value": {
          "template": "https://template:user:{secret}@template.example"
        }
      }
    },
    {
      "name": "whitespace in user",
      "accept": false,
      "credential": {
        "value": {
          "template": "https://template user:{secret}@template.example"
        }
      }
    },
    {
      "name": "missing host",
      "accept": false,
      "credential": {
        "value": {
          "template": "https://template-user:{secret}@"
        }
      }
    },
    {
      "name": "host path suffix",
      "accept": false,
      "credential": {
        "value": {
          "template": "https://template-user:{secret}@template.example/path"
        }
      }
    },
    {
      "name": "whitespace in host",
      "accept": false,
      "credential": {
        "value": {
          "template": "https://template-user:{secret}@template example"
        }
      }
    },
    {
      "name": "second non-empty line",
      "accept": false,
      "credential": {
        "value": {
          "template": "https://template-user:{secret}@template.example\nnot-a-credential"
        }
      }
    },
    {
      "name": "non-https scheme",
      "accept": false,
      "credential": {
        "value": {
          "template": "http://template-user:{secret}@template.example"
        }
      }
    },
    {
      "name": "empty user",
      "accept": false,
      "credential": {
        "value": {
          "template": "https://:{secret}@template.example"
        }
      }
    },
    {
      "name": "trailing text after placeholder",
      "accept": false,
      "credential": {
        "value": {
          "template": "https://template-user:{secret}x@template.example"
        }
      }
    },
    {
      "name": "leading whitespace",
      "accept": false,
      "credential": {
        "value": {
          "template": " https://template-user:{secret}@template.example"
        }
      }
    },
    {
      "name": "carriage-return blank line",
      "accept": false,
      "credential": {
        "value": {
          "template": "https://template-user:{secret}@template.example\n\r\n"
        }
      }
    },
    {
      "name": "vertical-tab blank line",
      "accept": false,
      "credential": {
        "value": {
          "template": "https://template-user:{secret}@template.example\n\u000b"
        }
      }
    },
    {
      "name": "form-feed blank line",
      "accept": false,
      "credential": {
        "value": {
          "template": "https://template-user:{secret}@template.example\n\f"
        }
      }
    },
    {
      "name": "no non-empty line",
      "accept": false,
      "credential": {
        "value": {
          "template": "\n \n"
        }
      }
    },
    {
      "name": "template is not a string",
      "accept": false,
      "credential": {
        "value": {
          "template": null
        }
      }
    },
    {
      "name": "incompatible encoding",
      "accept": false,
      "credential": {
        "value": {
          "template": "https://template-user:{secret}@template.example",
          "encode": "rclone-obscure"
        }
      }
    },
    {
      "name": "no value",
      "accept": false,
      "credential": {
        "credential": "no-value",
        "secret_path": "secrets/no-value.age"
      }
    },
    {
      "name": "format carrying a template value",
      "accept": false,
      "credential": {
        "format": "credential-store-url",
        "value": {
          "template": "[template]\ntype = ftp\npass = {secret}\n",
          "encode": "rclone-obscure"
        }
      }
    },
    {
      "name": "unrecognized format with a valid template",
      "accept": false,
      "credential": {
        "format": "raw",
        "value": {
          "template": "https://template-user:{secret}@template.example"
        }
      }
    }
  ]
}
