pr_explain_is_safe_utf8() {
  od -An -v -tu1 -- "$1" | awk '
    BEGIN { need = 0; bad = 0; lower = 128; upper = 191 }
    {
      for (i = 1; i <= NF; i++) {
        byte = $i + 0
        if (need > 0) {
          if (byte < lower || byte > upper) bad = 1
          need--
          lower = 128
          upper = 191
          continue
        }
        if (byte <= 127) {
          if (byte != 9 && byte != 10 && byte != 13 && byte < 32) bad = 1
        } else if (byte >= 194 && byte <= 223) {
          need = 1
        } else if (byte == 224) {
          need = 2
          lower = 160
        } else if ((byte >= 225 && byte <= 236) || (byte >= 238 && byte <= 239)) {
          need = 2
        } else if (byte == 237) {
          need = 2
          upper = 159
        } else if (byte == 240) {
          need = 3
          lower = 144
        } else if (byte >= 241 && byte <= 243) {
          need = 3
        } else if (byte == 244) {
          need = 3
          upper = 143
        } else {
          bad = 1
        }
      }
    }
    END { exit (bad || need != 0) ? 1 : 0 }
  '
}

pr_explain_body_tags_are_canonical() {
  awk '
    {
      rest = $0
      while (match(rest, /<[^>]*>/)) {
        tag = substr(rest, RSTART, RLENGTH)
        rest = substr(rest, RSTART + RLENGTH)
        if (tag ~ /^<\/[a-z][a-z0-9]*>$/) continue
        if (tag !~ /^<[a-z][a-z0-9]*([[:space:]]+[a-z][a-z0-9_.:-]*(="[^"]*")?)*>$/) {
          bad = 1
          continue
        }

        attrs = tag
        sub(/^<[a-z][a-z0-9]*/, "", attrs)
        sub(/>$/, "", attrs)
        tag_number++
        while (length(attrs)) {
          if (attrs !~ /^[[:space:]]+/) {
            bad = 1
            break
          }
          sub(/^[[:space:]]+/, "", attrs)
          name = attrs
          sub(/[=[:space:]].*$/, "", name)
          if (name == "" || seen[tag_number, name]) {
            bad = 1
            break
          }
          seen[tag_number, name] = 1
          attrs = substr(attrs, length(name) + 1)
          if (substr(attrs, 1, 2) == "=\"") {
            attrs = substr(attrs, 3)
            quote = index(attrs, "\"")
            if (!quote) {
              bad = 1
              break
            }
            attrs = substr(attrs, quote + 1)
          } else if (length(attrs) && attrs !~ /^[[:space:]]/) {
            bad = 1
            break
          }
        }
      }
    }
    END { exit bad ? 1 : 0 }
  ' "$1"
}

