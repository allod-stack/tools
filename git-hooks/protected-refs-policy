#!/usr/bin/env bash
set -euo pipefail

repo="$(git rev-parse --show-toplevel)"
common_dir="$(git rev-parse --path-format=absolute --git-common-dir)"
git_dir="$(git rev-parse --path-format=absolute --git-dir)"
# The branch lists are keyed on the repository, so a linked worktree must
# resolve to the repository it belongs to; $repo stays the working tree, which
# is where tracked hooks live.
if [ "$git_dir" = "$common_dir" ]; then
  main_repo="$repo"
else
  main_repo="$(dirname "$common_dir")"
fi
# Resolved once, because git reports physical paths: a $HOME that is a symlink,
# or one carrying a trailing slash, would otherwise fail to prefix them and turn
# a correctly placed checkout into a misplaced one.
home_physical="$HOME"
while [ "${home_physical%/}" != "$home_physical" ]; do home_physical="${home_physical%/}"; done
if home_resolved="$(cd "$HOME" 2>/dev/null && pwd -P)"; then
  home_physical="$home_resolved"
fi
hook="${1:?missing hook name}"
shift
protected_branches_file="$HOME/.config/git/protected-branches"
signing_required_branches_file="$HOME/.config/git/signing-required-branches"
active_pr_branches_file="$HOME/.config/git/active-pr-branches"
allowed_external_remotes_file="$HOME/.config/git/allowed-external-remotes"

hook_stdin=""
if [ "$hook" = "pre-push" ]; then
  hook_stdin="$(mktemp)"
  trap 'rm -f "$hook_stdin"' EXIT
  cat > "$hook_stdin"
fi

# The owner/repo the origin remote names, or failure when there is no origin or
# its URL carries no such tail. Twin of gitremote.RepoFromURL; the two are held
# together by tests/fixtures/protection-cases.tsv.
remote_identity() {
  local url repo_name rest owner
  url="$(git remote get-url origin 2>/dev/null)" || return 1
  while [ "${url%/}" != "$url" ]; do url="${url%/}"; done
  url="${url%.git}"
  while [ "${url%/}" != "$url" ]; do url="${url%/}"; done
  case "$url" in */*) ;; *) return 1 ;; esac
  repo_name="${url##*/}"
  rest="${url%/*}"
  owner="${rest##*[/:]}"
  case "$repo_name" in *:*) return 1 ;; esac
  if [ -z "$owner" ] || [ -z "$repo_name" ]; then
    return 1
  fi
  printf '%s/%s\n' "$owner" "$repo_name"
}

# Extra lines for the refusal, set by branch_listed when the entry that answered
# was reached through the origin remote rather than through the checkout path.
protection_detail=""

branch_list_unreadable() {
  echo "ERROR: cannot read the branch list '$1'; fix or remove that file." >&2
  exit 1
}

# Whether a branch list constrains $2 for this checkout. An entry keyed on the
# repository's own path answers first; failing that, an entry naming the
# repository that origin points at means the checkout is in the wrong place,
# which is a misconfiguration and never an absence of protection.
#
# Twin of lookupProtection in cmd/allod/workspace.go, held together by
# tests/fixtures/protection-cases.tsv.
branch_listed() {
  local list_file="$1" branch="$2"
  local main_relative="${main_repo#"$home_physical"/}"
  local identity expected_path status

  protection_detail=""

  [ -n "$branch" ] || return 1
  # An absent list is no policy on this machine. A list that is there and cannot
  # be read is a failure, and awk cannot report it: gawk skips an unreadable or
  # non-regular argument with a warning and still exits on its END status, so a
  # directory in place of the file would read as "not listed". Every caller of
  # this function sits in an 'if' condition or a command substitution, where
  # errexit is suspended, so the status checks below are explicit too.
  [ -e "$list_file" ] || return 1
  if [ ! -f "$list_file" ] || [ ! -r "$list_file" ]; then
    branch_list_unreadable "$list_file"
  fi

  status=0
  awk -v repo="$main_relative" -v branch="$branch" '
      /^[[:space:]]*(#|$)/ { next }
      { path = $1; sub(/\/+$/, "", path) }
      path == repo && $2 == branch { found = 1 }
      END { exit found ? 0 : 1 }
    ' "$list_file" || status=$?
  if [ "$status" -gt 1 ]; then
    branch_list_unreadable "$list_file"
  fi
  if [ "$status" -eq 0 ]; then
    return 0
  fi

  # An entry keyed on this very path settles the question: the checkout is where
  # its entry puts it, so there is no misplacement to report.
  status=0
  awk -v repo="$main_relative" '
      /^[[:space:]]*(#|$)/ { next }
      { path = $1; sub(/\/+$/, "", path) }
      path == repo { found = 1 }
      END { exit found ? 0 : 1 }
    ' "$list_file" || status=$?
  if [ "$status" -gt 1 ]; then
    branch_list_unreadable "$list_file"
  fi
  if [ "$status" -eq 0 ]; then
    return 1
  fi

  identity="$(remote_identity)" || return 1

  # Every entry naming the identity is consulted, not just the first: a
  # repository may have one entry per protected branch. index(), not a regex:
  # an owner or repository name may contain a dot.
  status=0
  expected_path="$(awk -v identity="$identity" -v branch="$branch" '
    /^[[:space:]]*(#|$)/ { next }
    {
      path = $1
      sub(/\/+$/, "", path)
      needle = "/" identity
      n = length(path) - length(needle)
      if (path == identity || (n >= 0 && substr(path, n + 1) == needle)) {
        if ($2 == branch) {
          print path
          exit
        }
      }
    }
  ' "$list_file")" || status=$?
  if [ "$status" -gt 1 ]; then
    branch_list_unreadable "$list_file"
  fi
  [ -n "$expected_path" ] || return 1

  protection_detail="Origin identifies this repository as '$identity', whose entry expects the checkout at '$expected_path'; it is at '$main_relative'. Move the checkout to '$expected_path'."
  return 0
}

is_protected_branch() {
  branch_listed "$protected_branches_file" "$1"
}

is_signing_required_branch() {
  branch_listed "$signing_required_branches_file" "$1"
}

is_active_pr_branch() {
  remote_url="$1"
  branch="$2"
  [ -r "$active_pr_branches_file" ] || return 1
  while IFS= read -r line; do
    case "$line" in \#*|"") continue ;; esac
    pattern="${line%% *}"
    br="${line##* }"
    case "$remote_url" in *"$pattern"*) ;; *) continue ;; esac
    [ "$br" = "$branch" ] && return 0
  done < "$active_pr_branches_file"
  return 1
}

is_allowed_external_remote() {
  remote_url="$1"
  # Personal forge is always allowed
  case "$remote_url" in *forge.anarch.diy*) return 0 ;; esac
  [ -r "$allowed_external_remotes_file" ] || return 1
  while IFS= read -r pattern; do
    case "$pattern" in \#*|"") continue ;; esac
    case "$remote_url" in *"$pattern"*) return 0 ;; esac
  done < "$allowed_external_remotes_file"
  return 1
}

require_signed_push() {
  sha="$1"
  branch="$2"

  if ! git verify-commit "$sha" 2>/dev/null; then
    echo "ERROR: Commits on '$branch' must be GPG-signed." >&2
    [ -z "$protection_detail" ] || echo "$protection_detail" >&2
    exit 1
  fi
}

branch_from_ref() {
  case "$1" in
    refs/heads/*) printf '%s\n' "${1#refs/heads/}" ;;
    *) printf '%s\n' "$1" ;;
  esac
}

require_override() {
  action="$1"
  branch="$2"

  echo "ERROR: '$action' is not permitted on protected branch '$branch'." >&2
  [ -z "$protection_detail" ] || echo "$protection_detail" >&2
  exit 1
}

# Through the common git dir, so a linked worktree still finds them: its .git is
# a file. Not `git rev-parse --git-path hooks`, which returns core.hooksPath
# when that is set — this script lives there, so it would call itself.
run_repo_hook() {
  repo_hook="$common_dir/hooks/$hook"
  if [ -x "$repo_hook" ]; then
    if [ -n "$hook_stdin" ]; then
      "$repo_hook" "$@" < "$hook_stdin"
    else
      "$repo_hook" "$@"
    fi
  fi
}

run_tracked_hook() {
  local hookspath_file="$repo/.hookspath"
  local hooks_dir=""

  if [ -r "$hookspath_file" ]; then
    hooks_dir="$(head -1 "$hookspath_file")"
  elif [ -d "$repo/.hooks" ]; then
    hooks_dir=".hooks"
  fi

  [ -n "$hooks_dir" ] || return 0

  local tracked_hook="$repo/$hooks_dir/$hook"
  if [ -x "$tracked_hook" ]; then
    if [ -n "$hook_stdin" ]; then
      "$tracked_hook" "$@" < "$hook_stdin"
    else
      "$tracked_hook" "$@"
    fi
  fi
}

case "$hook" in
  pre-commit)
    branch="$(git branch --show-current)"
    if is_protected_branch "$branch"; then
      require_override "commit on" "$branch"
    fi
    ;;
  pre-rebase)
    branch="${2:-$(git branch --show-current)}"
    if is_protected_branch "$branch"; then
      require_override "rebase" "$branch"
    fi
    ;;
  pre-merge-commit)
    branch="$(git branch --show-current)"
    if is_protected_branch "$branch"; then
      require_override "merge into" "$branch"
    fi
    ;;
  pre-push)
    remote_url="${2:-}"

    if ! is_allowed_external_remote "$remote_url"; then
      echo "ERROR: Push to '$remote_url' is not authorized." >&2
      exit 1
    fi

    while read -r local_ref local_sha remote_ref remote_sha; do
      if [[ "$remote_ref" == refs/for/* ]]; then
        echo "ERROR: AGit is not an accepted intake path for this workflow. Push an ordinary branch via allod change submit, or use the patch relay for public repositories." >&2
        exit 1
      fi

      local_branch="$(branch_from_ref "$local_ref")"
      remote_branch="$(branch_from_ref "$remote_ref")"

      if is_protected_branch "$local_branch"; then
        require_override "push from" "$local_branch"
      fi

      if is_protected_branch "$remote_branch"; then
        require_override "push to" "$remote_branch"
      fi

      if is_signing_required_branch "$remote_branch"; then
        require_signed_push "$local_sha" "$remote_branch"
      fi

      if is_active_pr_branch "$remote_url" "$remote_branch"; then
        require_signed_push "$local_sha" "$remote_branch"
      fi

      # Block non-fast-forward (force) pushes on agent/* and active PR branches
      zero="0000000000000000000000000000000000000000"
      if [ "$remote_sha" != "$zero" ] && [ "$local_sha" != "$zero" ]; then
        if ! git merge-base --is-ancestor "$remote_sha" "$local_sha" 2>/dev/null; then
          block_force=0
          if [[ "$remote_branch" == agent/* ]]; then
            block_force=1
          fi
          if is_active_pr_branch "$remote_url" "$remote_branch"; then
            block_force=1
          fi
          if [ "$block_force" = "1" ]; then
            echo "ERROR: force-push is not permitted on branch '$remote_branch'. Add commits instead." >&2
            exit 1
          fi
        fi
      fi
    done < "$hook_stdin"
    ;;
esac

run_tracked_hook "$@"
run_repo_hook "$@"
