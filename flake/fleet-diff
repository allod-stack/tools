#!/usr/bin/env bash
set -euo pipefail

# --- Color support ---
if [[ -t 1 ]]; then
  YELLOW=$'\033[33m'
  RED=$'\033[31m'
  RESET=$'\033[0m'
else
  YELLOW="" RED="" RESET=""
fi

# --- Exit codes ---
# Distinct so this composes as a preflight inside another command: a caller can
# tell "the fleet is not what you claimed" from "you called me wrong".
readonly EXIT_USAGE=1
readonly EXIT_MISMATCH=2
readonly EXIT_EVAL=3

usage() {
  cat <<'EOF'
Usage: fleet-diff [<deploy-checkout>] --override <input>=<rev> [...]
                  [--expect <machine>,... | --expect-none]

Evaluate every machine in a composition-root flake twice — once against the
committed lock, once with the given revisions substituted — and report which
machines' built systems change. Each machine is evaluated on its own, so a run
costs one machine's evaluation at a time rather than the whole fleet's at once.

Arguments:
  <deploy-checkout>          composition-root flake directory (default: .)

Options:
  --override <input>=<rev>   substitute one flake input, repeatable. <rev> is a
                             git revision; which repository it belongs to comes
                             from the checkout's own flake.lock. Abbreviate to 7
                             characters or more and it is expanded against the
                             remote's refs. A whole flake URL is accepted in the
                             same place, for a source the lock cannot name —
                             quote it, an unquoted & backgrounds the command.
                             Transitive inputs override by path (archetypes/vm),
                             direct ones by name (vm).
  --expect <machine>,...     machines expected to change, comma-separated and
                             repeatable. Mismatch fails in both directions.
  --expect-none              expect no machine to change (the land-inert case).
  -h, --help                 show this help.

Neither expectation flag means report-only: the per-machine result is printed
and nothing is asserted.

Exit status:
  0  the computed set matches the expectation, or none was declared
  1  usage or precondition error
  2  expectation mismatch
  3  evaluation failed

Examples:
  # Report which machines a branch would alter
  fleet-diff ~/work/allod/deploy --override archetypes/vm=1a2b3c4

  # Gate a land-inert merge: fail if any machine changes
  fleet-diff --override vm=1a2b3c4 --expect-none

  # Gate an activation change: fail unless exactly these machines change
  fleet-diff --override inventory=1a2b3c4 --expect allod-dev,allod-canary

  # A source flake.lock cannot name: give the whole flake URL instead
  fleet-diff --override 'vm=git+https://forge.example/vm.git?rev=<40-char-rev>'
EOF
}

die_usage() {
  echo "fleet-diff: $1" >&2
  usage >&2
  exit "$EXIT_USAGE"
}

# --- Arg parsing ---

CHECKOUT=""
EXPECT_NONE=false
EXPECT_GIVEN=false
END_OF_OPTIONS=false
declare -a OVERRIDE_INPUTS=()   # input path, as given
declare -a OVERRIDE_VALUES=()   # revision or whole flake URL, as given
declare -a OVERRIDE_LABELS=()   # what was asked for, and what it resolved to
declare -a NIX_OVERRIDE_ARGS=() # --override-input <input> <url>, quoted by the array
declare -a EXPECTED=()

# Record one --override value. Splitting on the *first* = only, because a flake
# URL's query string carries its own (?ref=…&rev=…). What the value means is
# settled later, once the lock is in hand: a revision needs the lock to say
# which repository it belongs to.
add_override() {
  local spec="$1" input value
  case "$spec" in
    *=*) ;;
    *) die_usage "--override needs <input>=<rev>, got: ${spec}" ;;
  esac
  input="${spec%%=*}"
  value="${spec#*=}"
  if ! [[ "$input" =~ ^[a-zA-Z0-9_-]+(/[a-zA-Z0-9_-]+)*$ ]]; then
    die_usage "invalid input name in --override: ${input}"
  fi
  [[ -n "$value" ]] || die_usage "--override has an empty value: ${spec}"
  # nix keeps only the last --override-input for a given input, so a second
  # one would print a receipt line for something that did not apply.
  for existing in ${OVERRIDE_INPUTS[@]+"${OVERRIDE_INPUTS[@]}"}; do
    [[ "$existing" != "$input" ]] \
      || die_usage "--override names ${input} twice; nix would keep only the last"
  done
  OVERRIDE_INPUTS+=("$input")
  OVERRIDE_VALUES+=("$value")
}

# Record one --expect value: comma-separated, and repeating the flag accumulates.
add_expect() {
  local value="$1" name
  local -a parts=()
  IFS=',' read -r -a parts <<< "$value"
  [[ ${#parts[@]} -gt 0 ]] || die_usage "--expect consumed no machine name"
  for name in "${parts[@]}"; do
    [[ -n "$name" ]] || die_usage "--expect consumed an empty machine name: ${value}"
    EXPECTED+=("$name")
  done
  EXPECT_GIVEN=true
}

set_checkout() {
  [[ -z "$CHECKOUT" ]] || die_usage "unexpected argument: $1"
  CHECKOUT="$1"
}

while [[ $# -gt 0 ]]; do
  if [[ "$END_OF_OPTIONS" == true ]]; then
    set_checkout "$1"
    shift
    continue
  fi
  case "$1" in
    --)
      END_OF_OPTIONS=true
      shift
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    --override)
      [[ $# -ge 2 && "$2" != -* ]] || die_usage "--override requires a value: <input>=<rev>"
      add_override "$2"
      shift 2
      ;;
    --override=*)
      add_override "${1#--override=}"
      shift
      ;;
    --expect)
      [[ $# -ge 2 && "$2" != -* ]] || die_usage "--expect requires a value: <machine>,..."
      add_expect "$2"
      shift 2
      ;;
    --expect=*)
      add_expect "${1#--expect=}"
      shift
      ;;
    --expect-none)
      EXPECT_NONE=true
      shift
      ;;
    -*)
      die_usage "unknown option: $1"
      ;;
    *)
      set_checkout "$1"
      shift
      ;;
  esac
done

# --- Preconditions ---

if [[ "$EXPECT_GIVEN" == true && "$EXPECT_NONE" == true ]]; then
  die_usage "--expect and --expect-none are mutually exclusive"
fi

if [[ ${#OVERRIDE_INPUTS[@]} -eq 0 ]]; then
  die_usage "missing required option: --override <input>=<rev>"
fi

[[ -n "$CHECKOUT" ]] || CHECKOUT="."
# Resolve into a second variable: a failed assignment would overwrite the name
# the diagnostic has to print.
if ! resolved=$(cd -- "$CHECKOUT" 2>/dev/null && pwd); then
  die_usage "not a directory: $CHECKOUT"
fi
CHECKOUT="$resolved"
if [[ ! -f "${CHECKOUT}/flake.nix" ]]; then
  die_usage "no flake.nix in ${CHECKOUT} — expected a composition-root checkout"
fi
if [[ ! -f "${CHECKOUT}/flake.lock" ]]; then
  die_usage "no flake.lock in ${CHECKOUT} — the baseline must be a committed lock"
fi

for tool in nix jq git; do
  command -v "$tool" >/dev/null 2>&1 \
    || die_usage "'${tool}' not found on PATH"
done

# Resolve an override path through the lock graph, hopping `follows` arrays as
# well as direct node keys. Prints the node it names, or nothing.
resolve_input_path() {
  jq -r --arg path "$1" '
    def resolve($node; $parts):
      if ($parts | length) == 0 then $node
      else
        (.nodes[$node].inputs[$parts[0]]) as $edge
        | if $edge == null then null
          elif ($edge | type) == "string" then resolve($edge; $parts[1:])
          elif ($edge | type) == "array" then
            (resolve("root"; $edge)) as $target
            | if $target == null then null else resolve($target; $parts[1:]) end
          else null
          end
      end;
    resolve("root"; ($path | split("/"))) // empty
  ' "${CHECKOUT}/flake.lock"
}

# The lock already records where each input came from, so a revision is enough
# to name a source. Prints "<type><TAB><url><TAB><owner><TAB><repo>"; the url is
# empty for a source this tool cannot turn back into a git remote.
lock_node_source() {
  jq -r --arg node "$1" '
    .nodes[$node].locked as $l
    | if $l == null then ["", "", "", ""]
      elif $l.type == "git" then [$l.type, ($l.url // ""), "", ""]
      elif $l.type == "github" then
        [$l.type, "https://\($l.host // "github.com")/\($l.owner)/\($l.repo).git", $l.owner, $l.repo]
      else [$l.type, "", "", ""]
      end
    | @tsv
  ' "${CHECKOUT}/flake.lock"
}

# Seven characters is git's own floor for core.abbrev=auto, which grows from
# there with the object count. The floor is only a sanity check: the guarantee
# is resolve_revision, which refuses an abbreviation naming no commit or more
# than one, so a collision fails loudly rather than pinning the wrong commit.
readonly REV_MIN_CHARS=7

is_revision() {
  [[ "$1" =~ ^[0-9a-fA-F]{${REV_MIN_CHARS},40}$ ]]
}

is_whole_revision() {
  [[ "$1" =~ ^[0-9a-fA-F]{40}$ ]]
}

is_hex() {
  [[ "$1" =~ ^[0-9a-fA-F]+$ ]]
}

# Expand an abbreviated revision against the remote's refs, which is the only
# place the rest of the hash exists. Sets REV to the whole revision and REFS to
# the refs carrying it, the latter only so the run's own output can say where
# the commit came from. A whole revision never reaches here: nix fetches one
# directly, so demanding it be some ref's tip would refuse a commit that works.
REV=""
REFS=""
resolve_revision() {
  local url="$1" want="${2,,}" listing line
  if ! listing=$(GIT_TERMINAL_PROMPT=0 git ls-remote --quiet "$url" 2>&1); then
    echo "fleet-diff: could not list the refs of ${url}" >&2
    printf '%s\n' "$listing" | sed 's/^/  /' >&2
    exit "$EXIT_USAGE"
  fi

  # Peeled tag entries (refs/tags/v1^{}) carry the commit an annotated tag
  # points at, which is the hash a person reads off a log, so keep them under
  # the tag's own name. HEAD only ever duplicates a branch that is also listed.
  local -a matches=()
  mapfile -t matches < <(printf '%s\n' "$listing" | awk -v want="$want" '
    index($1, want) == 1 {
      ref = $2
      sub(/\^\{\}$/, "", ref)
      if (ref == "HEAD") next
      print $1 "\t" ref
    }')

  local -A commits=()
  for line in "${matches[@]}"; do
    commits["${line%%$'\t'*}"]=1
  done

  if [[ ${#commits[@]} -eq 0 ]]; then
    echo "fleet-diff: no ref of ${url} carries a commit starting with ${want}" >&2
    echo "  an abbreviation can only be expanded against what the remote lists," >&2
    echo "  so it has to be pushed and be the tip of a branch, tag, or pull request" >&2
    echo "  any other commit takes its whole 40-character revision instead" >&2
    exit "$EXIT_USAGE"
  fi
  if [[ ${#commits[@]} -gt 1 ]]; then
    echo "fleet-diff: ${want} names ${#commits[@]} commits on ${url}: ${!commits[*]}" >&2
    echo "  give more characters" >&2
    exit "$EXIT_USAGE"
  fi

  REV="${!commits[*]}"
  REFS=""
  for line in "${matches[@]}"; do
    REFS="${REFS:+${REFS}, }${line#*$'\t'}"
  done
}

# Only the revision is pinned. Nix reaches a commit without being told which ref
# carries it — verified against a cold fetcher cache — so naming one here would
# add a second thing that has to stay true for no gain.
compose_override_url() {
  local type="$1" url="$2" owner="$3" repo="$4" rev="$5"
  case "$type" in
    github)
      printf 'github:%s/%s/%s' "$owner" "$repo" "$rev"
      ;;
    *)
      url="${url#git+}"
      printf 'git+%s?rev=%s' "$url" "$rev"
      ;;
  esac
}

# Nix treats an override for an input it cannot find as a warning and evaluates
# the baseline anyway, exit 0 — so a mistyped path would report every machine
# unchanged and pass --expect-none while proving nothing. Refuse instead, and
# refuse every bad path before resolving any revision, so a typo costs no
# network round trip.
declare -a OVERRIDE_NODES=()
declare -a UNRESOLVED=()
for input in "${OVERRIDE_INPUTS[@]}"; do
  node=$(resolve_input_path "$input")
  OVERRIDE_NODES+=("$node")
  [[ -n "$node" ]] || UNRESOLVED+=("$input")
done
if [[ ${#UNRESOLVED[@]} -gt 0 ]]; then
  echo "fleet-diff: --override names inputs absent from ${CHECKOUT}/flake.lock: ${UNRESOLVED[*]}" >&2
  echo "  transitive inputs override by path (archetypes/vm), direct ones by name" >&2
  echo "  direct inputs: $(jq -r '.nodes.root.inputs | keys | join(" ")' "${CHECKOUT}/flake.lock")" >&2
  exit "$EXIT_USAGE"
fi

for i in "${!OVERRIDE_INPUTS[@]}"; do
  input="${OVERRIDE_INPUTS[$i]}"
  value="${OVERRIDE_VALUES[$i]}"

  if is_hex "$value" && ! is_revision "$value"; then
    if [[ ${#value} -lt $REV_MIN_CHARS ]]; then
      die_usage "a revision needs at least ${REV_MIN_CHARS} characters, got ${#value}: ${input}=${value}"
    fi
    die_usage "a revision is at most 40 characters, got ${#value}: ${input}=${value}"
  fi

  if ! is_revision "$value"; then
    OVERRIDE_LABELS+=("${input}=${value}")
    NIX_OVERRIDE_ARGS+=(--override-input "$input" "$value")
    continue
  fi

  IFS=$'\t' read -r source_type source_url source_owner source_repo \
    <<< "$(lock_node_source "${OVERRIDE_NODES[$i]}")"
  if [[ -z "$source_url" ]]; then
    die_usage "cannot name a repository for ${input}: flake.lock records it as a '${source_type:-unknown}' source, so give the whole flake URL in place of a revision"
  fi

  rev="${value,,}"
  found_on=""
  if ! is_whole_revision "$rev"; then
    resolve_revision "$source_url" "$rev"
    rev="$REV"
    found_on="  (${REFS})"
  fi

  resolved=$(compose_override_url "$source_type" "$source_url" \
    "$source_owner" "$source_repo" "$rev")
  OVERRIDE_LABELS+=("${input}=${value} → ${resolved}${found_on}")
  NIX_OVERRIDE_ARGS+=(--override-input "$input" "$resolved")
done

# The baseline is meant to be the *committed* lock. An edited flake.nix or
# flake.lock in the working tree silently moves it, which would make an
# unchanged verdict meaningless, so say so rather than quietly comparing the
# wrong pair.
dirty=$(git -C "$CHECKOUT" status --porcelain -- flake.nix flake.lock 2>/dev/null || true)
if [[ -n "$dirty" ]]; then
  echo "fleet-diff: warning: uncommitted flake.nix/flake.lock in ${CHECKOUT} —" >&2
  echo "  the baseline is the working tree, not the committed lock" >&2
fi

# --- Fleet enumeration ---

EXPECTATION_LABEL="none declared"
if [[ "$EXPECT_NONE" == true ]]; then
  EXPECTATION_LABEL="no machine changes"
elif [[ "$EXPECT_GIVEN" == true ]]; then
  EXPECTATION_LABEL="${EXPECTED[*]}"
fi

if ! machines_json=$(nix eval "${CHECKOUT}#nixosConfigurations" \
  --apply builtins.attrNames --json --no-write-lock-file); then
  echo "fleet-diff: could not enumerate nixosConfigurations in ${CHECKOUT}" >&2
  exit "$EXIT_EVAL"
fi

declare -a MACHINES=()
mapfile -t MACHINES < <(printf '%s' "$machines_json" | jq -r '.[]')

if [[ ${#MACHINES[@]} -eq 0 ]]; then
  echo "fleet-diff: ${CHECKOUT} composes no nixosConfigurations" >&2
  exit "$EXIT_EVAL"
fi

declare -A IN_FLEET=()
for machine in "${MACHINES[@]}"; do
  IN_FLEET["$machine"]=1
done

# Catch a typo before spending minutes of evaluation on it, and so a misspelled
# name never reads as "expected to change, did not".
declare -a UNKNOWN=()
for machine in "${EXPECTED[@]}"; do
  [[ -n "${IN_FLEET[$machine]:-}" ]] || UNKNOWN+=("$machine")
done
if [[ ${#UNKNOWN[@]} -gt 0 ]]; then
  echo "fleet-diff: --expect names machines not in this fleet: ${UNKNOWN[*]}" >&2
  echo "  fleet: ${MACHINES[*]}" >&2
  exit "$EXIT_USAGE"
fi

# --- Per-machine sequential evaluation ---

printf 'fleet-diff: %d machines in %s\n' "${#MACHINES[@]}" "$CHECKOUT"
for label in "${OVERRIDE_LABELS[@]}"; do
  printf '  override:     %s\n' "$label"
done
printf '  expectation:  %s\n' "$EXPECTATION_LABEL"
echo ""

declare -a CHANGED=()

for machine in "${MACHINES[@]}"; do
  attr="${CHECKOUT}#nixosConfigurations.${machine}.config.system.build.toplevel.drvPath"

  if ! base=$(nix eval "$attr" --raw --no-write-lock-file); then
    echo "fleet-diff: baseline evaluation failed for ${machine}" >&2
    exit "$EXIT_EVAL"
  fi
  if ! candidate=$(nix eval "$attr" --raw --no-write-lock-file \
    "${NIX_OVERRIDE_ARGS[@]}"); then
    echo "fleet-diff: candidate evaluation failed for ${machine}" >&2
    exit "$EXIT_EVAL"
  fi

  if [[ "$base" == "$candidate" ]]; then
    printf '  %-22s %s\n' "$machine" "unchanged"
  else
    printf '  %-22s %s\n' "$machine" "${YELLOW}CHANGES${RESET}"
    CHANGED+=("$machine")
  fi
done

echo ""
printf '%d of %d machines change.\n' "${#CHANGED[@]}" "${#MACHINES[@]}"
printf 'Scope: the fleet this checkout composes — another composition root has its own.\n'

# --- Expectation ---

if [[ "$EXPECT_GIVEN" == false && "$EXPECT_NONE" == false ]]; then
  echo "No expectation declared — report only, nothing asserted."
  exit 0
fi

declare -A IS_EXPECTED=()
for machine in "${EXPECTED[@]}"; do
  IS_EXPECTED["$machine"]=1
done
declare -A IS_CHANGED=()
for machine in "${CHANGED[@]}"; do
  IS_CHANGED["$machine"]=1
done

declare -a UNEXPECTED=()
for machine in "${CHANGED[@]}"; do
  [[ -n "${IS_EXPECTED[$machine]:-}" ]] || UNEXPECTED+=("$machine")
done
declare -a MISSING=()
for machine in "${MACHINES[@]}"; do
  if [[ -n "${IS_EXPECTED[$machine]:-}" && -z "${IS_CHANGED[$machine]:-}" ]]; then
    MISSING+=("$machine")
  fi
done

if [[ ${#UNEXPECTED[@]} -eq 0 && ${#MISSING[@]} -eq 0 ]]; then
  echo "Expectation matches."
  exit 0
fi

echo ""
echo "${RED}Expectation mismatch.${RESET}"
if [[ ${#UNEXPECTED[@]} -gt 0 ]]; then
  printf '  changed, not expected:     %s\n' "${UNEXPECTED[*]}"
fi
if [[ ${#MISSING[@]} -gt 0 ]]; then
  printf '  expected, did not change:  %s\n' "${MISSING[*]}"
fi
exit "$EXIT_MISMATCH"
