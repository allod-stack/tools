#!/usr/bin/env bash
# allod pr explain — generate a comprehension-first PR explanation report.
# Dispatched by the `allod` CLI, which resolves this directory from the Nix
# store via ALLOD_TOOLS_DIR. See docs/pr-explain.md.
set -euo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=/dev/null
source "$SCRIPT_DIR/../lib/workspace.sh"
# shellcheck source=/dev/null
source "$SCRIPT_DIR/lib.sh"

declare -a TEMP_FILES=()
PR_EXPLAIN_JOB_DIR=""
PR_EXPLAIN_PUBLISH_TEMP=""
PR_EXPLAIN_SIGNAL_STATUS=0

handle_signal() {
  local status="$1" signal="$2"
  PR_EXPLAIN_SIGNAL_STATUS="$status"
  printf 'allod: interrupted by %s\n' "$signal" >&2
  if [[ -n "${PR_EXPLAIN_PROVIDER_PID:-}" ]]; then
    kill -TERM "$PR_EXPLAIN_PROVIDER_PID" 2>/dev/null || true
  fi
}

cleanup_temp_files() {
  local status=$?
  if [[ "$PR_EXPLAIN_SIGNAL_STATUS" -ne 0 ]]; then
    status="$PR_EXPLAIN_SIGNAL_STATUS"
  fi
  local file
  for file in "${TEMP_FILES[@]}"; do
    rm -f "$file"
  done

  if [[ -n "$PR_EXPLAIN_PUBLISH_TEMP" ]]; then
    rm -f -- "$PR_EXPLAIN_PUBLISH_TEMP"
  fi
  if [[ "$status" -ne 0 && -n "$PR_EXPLAIN_JOB_DIR" && -d "$PR_EXPLAIN_JOB_DIR" ]]; then
    printf 'allod: diagnostics preserved: %s\n' "$PR_EXPLAIN_JOB_DIR" >&2
  fi

  return "$status"
}
trap cleanup_temp_files EXIT
trap 'handle_signal 130 SIGINT' INT
trap 'handle_signal 143 SIGTERM' TERM

pr_usage() {
  cat <<'EOF'
Usage:
  allod pr explain <number> (--codex | --claude | --pi) [-R|--repo <owner/repo>]
    [--checkout <path>] --output <report.html> [--replace] [--dry-run]
    [--model <model>] [--effort <low|medium|high|xhigh|max>]
    [--force-tier <T1|T2|T3>] [--no-slop] [--no-repair]

The provider flag is explicit consent to send the pull request's source and
review context to that installed CLI. --codex and --claude spend their
subscriptions; --pi spends metered API credits through the pi coding agent,
which authenticates from its own credential store — API keys and provider
credentials in the environment are always stripped, for every runner. Before
invoking it, allod prints the repository, PR, immutable base/head commits,
runner, output, and how many provider calls the run may make.

A run opens with a triage pass: the provider assesses the change and writes a
structured complexity judgment (tier, reading budget, concepts, learning
objectives) that shapes the report. A T0 tier means the pull request body
already suffices; the run prints that judgment and generates nothing.
--force-tier replaces the tier judgment in either direction and is recorded
in the judgment itself.

After triage, an outline pass plans the report's sections and writes its
front matter; each planned section is then authored by its own provider call
with the full reader contract re-anchored, and a final call writes the quiz
and provenance. The tool assembles those fragments into the report body. A
deletion-only slop pass tightens the assembled prose; --no-slop skips it.
When the assembled report fails validation, allod sends the validator's
diagnostics back to the same provider for exactly one repair pass. A full run
therefore costs at most 17 provider calls (triage, outline, one per section
up to the twelve-section budget cap, quiz, slop, repair); --no-slop and
--no-repair each remove one, and --no-repair fails the run on the first
validation failure. Validation itself is identical either way.

The model defaults to the selected CLI's built-in default. Explanation effort
defaults to high. --dry-run resolves and verifies the snapshot without
running a provider or writing a report.
EOF
}

die() {
  local code="$1"
  shift
  printf 'allod: %s\n' "$*" >&2
  exit "$code"
}

require_option_value() {
  local option="$1"
  local count="$2"
  [[ "$count" -ge 2 ]] || die 1 "$option requires a value"
}

make_temp_file() {
  local destination="$1" file
  file=$(mktemp)
  TEMP_FILES+=("$file")
  printf -v "$destination" '%s' "$file"
}

resolve_git_repo() {
  local input="${1:-$PWD}"
  local top
  [[ -d "$input" ]] || die 1 "not a directory: $input"
  top=$(git -C "$input" rev-parse --show-toplevel 2>/dev/null) ||
    die 1 "not a git repository: $input"
  workspace_is_repo_root "$top" ||
    die 1 "could not resolve git repository root for: $input"
  printf '%s\n' "$top"
}

git_remote_identity() {
  local remote="$1"
  local host path host_lc
  local scheme_re='^(https?|ssh|git)://([^/@]+@)?([^/:?#]+)(:[0-9]+)?/(.+)$'
  local scp_re='^[^/@:]+@([^/:]+):(.+)$'

  [[ -n "$remote" && "$remote" != *$'\n'* ]] || return 1

  if [[ "$remote" =~ $scheme_re ]]; then
    host="${BASH_REMATCH[3]}"
    path="${BASH_REMATCH[5]}"
  elif [[ "$remote" =~ $scp_re ]]; then
    host="${BASH_REMATCH[1]}"
    path="${BASH_REMATCH[2]}"
    [[ "$path" != /* ]] || return 1
  else
    return 1
  fi

  [[ -n "$host" && -n "$path" ]] || return 1
  [[ "$path" != *['?#']* ]] || return 1
  path="${path%/}"
  path="${path%.git}"
  [[ -n "$path" && "$path" == */* ]] || return 1

  host_lc=$(printf '%s' "$host" | tr '[:upper:]' '[:lower:]')
  printf '%s/%s\n' "$host_lc" "$path"
}

git_remotes_match() {
  local left="$1" right="$2"
  local left_identity right_identity

  [[ "$left" == "$right" ]] && return 0

  if left_identity=$(git_remote_identity "$left") && right_identity=$(git_remote_identity "$right"); then
    [[ "$left_identity" == "$right_identity" ]]
  else
    return 1
  fi
}

