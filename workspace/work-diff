#!/usr/bin/env bash
set -euo pipefail

if ! declare -F workspace_collect_repos >/dev/null; then
    # shellcheck source=/dev/null
    source "$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)/../lib/workspace.sh"
fi

usage() {
    cat <<'EOF'
Usage: work-diff [--all | <repo-name>]

  (no args)       show all git repos in ~/work
  --all           same as above
  <repo-name>     show only ~/work/<repo-name>
  -h, --help      this message

Each repo's linked worktrees are shown under it, wherever they are sited.
EOF
    exit 0
}

sep() { printf '%.0s═' $(seq 1 60); echo; }

show_tree_state() {
    local dir="$1"

    local status staged unstaged
    status=$(git -C "$dir" status --porcelain 2>/dev/null)

    if [[ -z "$status" ]]; then
        echo "  (clean)"
        return 0
    fi

    echo "$status"

    staged=$(git -C "$dir" diff --cached 2>/dev/null)
    unstaged=$(git -C "$dir" diff 2>/dev/null)

    [[ -n "$staged" ]]   && printf '\n--- staged ---\n%s\n' "$staged"
    [[ -n "$unstaged" ]] && printf '\n--- unstaged ---\n%s\n' "$unstaged"
    # Explicit: a trailing test that fails would abort the whole run under set -e.
    return 0
}

# Linked worktrees hold agent branch work that lives outside ~/work, so render
# them under the repo they belong to, attributed to their branch.
show_worktrees() {
    local dir="$1" path branch

    while IFS=$'\t' read -r path branch; do
        echo
        printf '  ↳ worktree %s  [%s]\n' "$path" "${branch:-detached}"
        show_tree_state "$path"
    done < <(workspace_collect_worktrees "$dir")
}

show_repo() {
    local dir="$1"
    workspace_is_repo_root "$dir" || return 0

    local name branch
    name="${dir#"$WORK_DIR"/}"
    name="${name%/}"
    branch=$(git -C "$dir" branch --show-current 2>/dev/null)

    echo
    sep
    printf '  %s  [%s]\n' "$name" "$branch"
    sep

    show_tree_state "$dir"
    show_worktrees "$dir"
}

show_all() {
    local repo
    while IFS= read -r repo; do
        show_repo "$WORK_DIR/$repo"
    done < <(workspace_collect_repos "$WORK_DIR")
}

case "${1:-}" in
    -h|--help) usage ;;
    --all|"")  show_all ;;
    -*)        echo "Unknown option: $1" >&2; exit 1 ;;
    *)
        [[ -d "$WORK_DIR/$1" ]] || { echo "Error: '$1' not found in $WORK_DIR" >&2; exit 1; }
        show_repo "$WORK_DIR/$1"
        ;;
esac
